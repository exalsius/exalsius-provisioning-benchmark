# Scenario 3 — Sharded inference. Deltas over common.env.
# Two L40 nodes, one decode replica sharded (tensor-parallel) across both nodes.
# gpuCount=2 with one GPU/node => 2-node tensor-parallel shard (no separate
# multinode switch; the llm-d-model chart places the shard workers).
# All values keep the ${VAR:-default} form so an environment override wins over
# the scenario default.
CLUSTER_NAME="${CLUSTER_NAME:-bench-s3}"
WORKSPACE_NAME="${WORKSPACE_NAME:-s3-sharded}"
EXPECTED_NODE_COUNT="${EXPECTED_NODE_COUNT:-2}"

DECODE_REPLICAS="${DECODE_REPLICAS:-1}"             # -> ms.decode.replicas
GPU_COUNT_PER_REPLICA="${GPU_COUNT_PER_REPLICA:-2}" # -> ms.decode.parallelism.tensor (2 nodes)
