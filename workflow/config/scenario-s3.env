# Scenario 3 — Sharded inference. Deltas over common.env.
# Two L40 nodes, one model sharded (tensor-parallel) across both.
#   TP = NODES_PER_REPLICA × GPU_COUNT_PER_REPLICA = 2 × 1 = 2
#   model copies = REPLICAS / NODES_PER_REPLICA = 2 / 2 = 1
# Two pods (one per node) cooperate as ONE model via cross-node tensor
# parallelism — the chart renders a LeaderWorkerSet of size 2 (leader serves the
# API, worker joins over NCCL). All values keep the ${VAR:-default} form so an
# environment override wins over the scenario default.
CLUSTER_NAME="${CLUSTER_NAME:-bench-s3}"
WORKSPACE_NAME="${WORKSPACE_NAME:-s3-sharded}"
EXPECTED_NODE_COUNT="${EXPECTED_NODE_COUNT:-2}"

REPLICAS="${REPLICAS:-2}"                           # -> resources.replicas (2 pods, 1 model)
GPU_COUNT_PER_REPLICA="${GPU_COUNT_PER_REPLICA:-1}" # -> resources.perReplica.gpuCount (GPUs/pod)
NODES_PER_REPLICA="${NODES_PER_REPLICA:-2}"         # -> modelServer.nodesPerReplica (2 pods = 1 model)
