# =============================================================================
# Common configuration shared by all benchmark scenarios.
# Values here are overridden by config/scenario-<id>.env and by the environment.
# Secrets (HF_TOKEN) MUST come from the environment, never this committed file.
# =============================================================================

# --- model under test (medium-sized LLM) ------------------------------------
# The Hugging Face repo id. In workspace-hub 1.0.0 this is the single model
# field (values.model.name): the vLLM argument AND the name clients send / the
# gateway routes on. (The old hf:// MODEL_URI is gone — vLLM takes the repo id.)
MODEL_ID="${MODEL_ID:-Qwen/Qwen3-8B}"

# --- provided nodes (override per run; see README) --------------------------
# Comma-separated list of SSH endpoints "ip:port". Scenario files assert the
# expected count. Example: NODE_ENDPOINTS="10.0.0.1:22,10.0.0.2:22"
NODE_ENDPOINTS="${NODE_ENDPOINTS:-}"
# No defaults — the workflow prompts for the SSH username and key (or use the
# --ssh-user / --ssh-key flags, or SSH_USERNAME / SSH_KEY_PATH). We never silently
# fall back to a guessed username or the operator's personal key.
SSH_USERNAME="${SSH_USERNAME:-}"
SSH_KEY_PATH="${SSH_KEY_PATH:-}"

# --- kubernetes / k0s -------------------------------------------------------
# KCM 1.8.0's flux pre-install check requires Kubernetes >= 1.32.0, so k0s must
# be >= 1.32 (v1.30.x fails kcm-flux-check with BackoffLimitExceeded).
K0S_VERSION="${K0S_VERSION:-v1.33.8+k0s.1}"
KCM_NAMESPACE="${KCM_NAMESPACE:-kcm-system}"
WORKSPACE_NAMESPACE="${WORKSPACE_NAMESPACE:-kcm-system}"
KOF_NAMESPACE="${KOF_NAMESPACE:-kof}"
GPU_OPERATOR_NAMESPACE="${GPU_OPERATOR_NAMESPACE:-gpu-operator}"

# A default StorageClass is required for the KOF/VictoriaMetrics PVCs. Bare k0s
# ships none, so the workflow installs OpenEBS; its localpv hostpath class
# (openebs-hostpath) is made the default.
OPENEBS_CHART="${OPENEBS_CHART:-openebs/openebs}"
OPENEBS_VERSION="${OPENEBS_VERSION:-4.5.1}"
OPENEBS_NAMESPACE="${OPENEBS_NAMESPACE:-openebs}"

# --- helm charts (pinned versions) ------------------------------------------
# k0rdent / KCM (Cluster API management).
KCM_CHART="${KCM_CHART:-oci://ghcr.io/k0rdent/kcm/charts/kcm}"
KCM_VERSION="${KCM_VERSION:-1.8.0}"
# exalsius-operator (Colony/WorkspaceClass/WorkspaceDeployment CRDs).
EXALSIUS_OPERATOR_CHART="${EXALSIUS_OPERATOR_CHART:-oci://ghcr.io/exalsius/charts/exalsius-operator}"
EXALSIUS_OPERATOR_VERSION="${EXALSIUS_OPERATOR_VERSION:-0.11.1}"
# NVIDIA GPU operator (device plugin + DCGM exporter). The chart is served from
# GitHub Pages — the old NGC repo (helm.ngc.nvidia.com) now returns 401/403.
# v25.10.x: default driver has Ubuntu 24.04 images (v24.9.x's 550.127.08 does not)
# and supports k8s 1.33. k0s-specific containerd wiring is in
# templates/gpu-operator-values.yaml (from the k0rdent catalog).
GPU_OPERATOR_REPO_URL="${GPU_OPERATOR_REPO_URL:-https://nvidia.github.io/gpu-operator}"
GPU_OPERATOR_CHART="${GPU_OPERATOR_CHART:-nvidia/gpu-operator}"
GPU_OPERATOR_VERSION="${GPU_OPERATOR_VERSION:-v25.10.1}"
# Let the operator install the NVIDIA driver (nodes are bare — no host driver).
# Set to false only if the nodes already have a host driver.
GPU_OPERATOR_DRIVER_ENABLED="${GPU_OPERATOR_DRIVER_ENABLED:-true}"

# --- observability: k0rdent KOF (VictoriaMetrics storage + OTel collectors) --
# KOF replaces a plain Prometheus stack: it gives a storage layer (VictoriaMetrics
# for metrics/logs/traces) and OpenTelemetry collectors. We run it "regionless"
# (single-cluster: the benchmark cluster stores its own telemetry). Istio is
# NOT used. A single umbrella release installs operators + mothership + storage + collectors
# (sub-chart toggles in templates/kof-values.yaml).
KOF_CHART="${KOF_CHART:-oci://ghcr.io/k0rdent/kof/charts/kof}"
KOF_VERSION="${KOF_VERSION:-1.8.0}"
# VictoriaMetrics query endpoint used by the collect phase (vmauth in front of
# the vmcluster). vmauth is disabled, so query vmselect directly (service
# vmselect-<vmcluster>).
VM_QUERY_SERVICE="${VM_QUERY_SERVICE:-vmselect-cluster}"
VM_QUERY_PORT="${VM_QUERY_PORT:-8481}"
VM_QUERY_PATH="${VM_QUERY_PATH:-/select/0/prometheus/api/v1/query}"

# --- cluster adoption into k0rdent ------------------------------------------
# Template name is version-specific in k0rdent (`kubectl get clustertemplate -n kcm-system`).
ADOPTED_CLUSTER_TEMPLATE="${ADOPTED_CLUSTER_TEMPLATE:-adopted-cluster-1-0-1}"
CREDENTIAL_NAME="${CREDENTIAL_NAME:-benchmark-adopted-cred}"
# The workspace-deployment controller reads the child kubeconfig from a Secret
# named "<clusterDeployment>-kubeconfig" in the WorkspaceDeployment's namespace,
# so the name is derived from CLUSTER_NAME at load time (see load_config). Do not
# hardcode a different name here.
KUBECONFIG_SECRET_NAME="${KUBECONFIG_SECRET_NAME:-}"

# Only keep the k0rdent providers we actually need — the cluster is *adopted*,
# not provisioned, so all the cloud CAPI providers (aws/azure/gcp/docker/...) are
# dead weight (capd even crashloops). After KCM installs, prepare patches the
# Management's provider list down to just these (keeping KCM's core intact).
KCM_PROVIDERS="${KCM_PROVIDERS:-cluster-api-provider-k0sproject-k0smotron projectsveltos}"

# --- inference endpoint (agentgateway + model header) -----------------------
# Requests (functional probe + aiperf) go to the shared agentgateway
# `llm-d-inference-gateway` in `default` on port 80. Its /v1 route forwards to the
# model's InferencePool, but ONLY when the request carries the header
# X-Gateway-Model-Name: <model>. Normally the per-model service's mesh HTTPRoute
# injects it — but we run WITHOUT the ambient mesh, so we set it explicitly.
# (Verified: gateway :80 /v1/chat/completions + this header -> 200 completion.)
ENDPOINT_SERVICE="${ENDPOINT_SERVICE:-llm-d-inference-gateway}"
ENDPOINT_NAMESPACE="${ENDPOINT_NAMESPACE:-default}"
ENDPOINT_PORT="${ENDPOINT_PORT:-80}"
MODEL_HEADER_NAME="${MODEL_HEADER_NAME:-X-Gateway-Model-Name}"

# --- node OS tuning (applied over SSH in bootstrap) -------------------------
# Many controllers/pods (KOF, operators, otel) consume inotify watches/instances;
# the distro defaults are too low.
NODE_INOTIFY_MAX_USER_WATCHES="${NODE_INOTIFY_MAX_USER_WATCHES:-524288}"
NODE_INOTIFY_MAX_USER_INSTANCES="${NODE_INOTIFY_MAX_USER_INSTANCES:-8192}"
NODE_NOFILE_LIMIT="${NODE_NOFILE_LIMIT:-65535}"

# --- workspace (llm-d-model, workspace-hub 1.0.0) ---------------------------
WORKSPACE_CLASS="${WORKSPACE_CLASS:-llm-d-model-1-0-0}"
HF_SECRET_NAME="${HF_SECRET_NAME:-hf-token}"
# Per-pod CPU request for the model server, set on the WorkspaceDeployment below
# the WorkspaceClass default (8) so the pod fits alongside k0s/KCM/KOF/GPU-operator
# on the co-located benchmark node.
WORKSPACE_CPU="${WORKSPACE_CPU:-4}"
# GPU vendor for the model's accelerator (NVIDIA|AMD). REQUIRED on the
# WorkspaceDeployment: the operator resolves the extended-resource name from it
# (NVIDIA -> nvidia.com/gpu) and injects gpuResourceName, which the chart needs
# to render the GPU request. Without it the model pod gets no GPU.
GPU_VENDOR="${GPU_VENDOR:-NVIDIA}"
# NB: topology (REPLICAS, GPU_COUNT_PER_REPLICA, NODES_PER_REPLICA) is set only in
# config/scenario-*.env — defaulting it here would shadow the scenario values
# (common.env is sourced first, so an existing value wins the scenario ${VAR:-…}).
# llm-d 0.9.0's CUDA 13 images (ghcr.io/llm-d/llm-d-cuda:v0.9.0) require NVIDIA
# driver >= 580 — the GPU operator version below must ship a >=580 driver branch.
# Gateway API CRDs — the llm-d-infra prerequisite creates Gateway/HTTPRoute
# (gateway.networking.k8s.io/v1), which need the EXPERIMENTAL channel. The
# manifest is large, so it is applied server-side.
GATEWAY_API_VERSION="${GATEWAY_API_VERSION:-1.6.1}"
GATEWAY_API_MANIFEST="${GATEWAY_API_MANIFEST:-https://github.com/kubernetes-sigs/gateway-api/releases/download/v${GATEWAY_API_VERSION}/experimental-install.yaml}"

# --- standard inference workload, driven by aiperf --------------------------
# aiperf runs IN-CLUSTER as a Kubernetes Job and hits the workspace Service over
# cluster DNS. It is distributed as a Python package, so we run it on a Python
# base image and `pip install` it at container start (AIPERF_PIP_SPEC pins the version).
AIPERF_IMAGE="${AIPERF_IMAGE:-python:3.12-slim}"
AIPERF_PIP_SPEC="${AIPERF_PIP_SPEC:-aiperf}"
# Kept low so the client schedules on the tight single co-located node.
AIPERF_CPU_REQUEST="${AIPERF_CPU_REQUEST:-250m}"
AIPERF_MEM_REQUEST="${AIPERF_MEM_REQUEST:-512Mi}"
LOAD_N_PROMPTS="${LOAD_N_PROMPTS:-200}"      # aiperf --request-count
LOAD_CONCURRENCY="${LOAD_CONCURRENCY:-16}"   # aiperf --concurrency
LOAD_INPUT_TOKENS="${LOAD_INPUT_TOKENS:-512}"  # aiperf --synthetic-input-tokens-mean
LOAD_OUTPUT_TOKENS="${LOAD_OUTPUT_TOKENS:-128}" # aiperf --output-tokens-mean
# Warm-up requests issued (and excluded from the measurement) before the run.
LOAD_WARMUP_PROMPTS="${LOAD_WARMUP_PROMPTS:-10}" # aiperf --warmup-request-count
# aiperf waits up to this long (s) for the model to actually serve before sending
# load — the Job is rendered right after the Service is discovered, so the model
# may still be loading.
AIPERF_MODEL_READY_TIMEOUT="${AIPERF_MODEL_READY_TIMEOUT:-300}" # --wait-for-model-timeout
# Per-request timeout (s). aiperf's own default is 6h, which can silently stall
# the experiment; cap it at a sane value.
AIPERF_REQUEST_TIMEOUT="${AIPERF_REQUEST_TIMEOUT:-300}" # --request-timeout-seconds

# --- timeouts (seconds) — indicative, not acceptance gates ------------------
TIMEOUT_BOOTSTRAP="${TIMEOUT_BOOTSTRAP:-1200}"
TIMEOUT_PREPARE="${TIMEOUT_PREPARE:-1200}"
TIMEOUT_WORKSPACE="${TIMEOUT_WORKSPACE:-1500}"
# How long the functional probe retries for a valid completion before failing.
TIMEOUT_FUNCPROBE="${TIMEOUT_FUNCPROBE:-600}"
# Wait budget for all KOF Flux HelmReleases (mothership/storage/collectors/VM
# operator) to reconcile Ready after the umbrella install.
TIMEOUT_KOF="${TIMEOUT_KOF:-1200}"
