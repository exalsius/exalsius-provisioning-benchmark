# Scenario 1 — Single-node inference. Deltas over common.env.
# One L40 node, one model-server pod, one GPU (tensor-parallel size 1).
#   TP = NODES_PER_REPLICA × GPU_COUNT_PER_REPLICA = 1 × 1 = 1
#   model copies = REPLICAS / NODES_PER_REPLICA = 1 / 1 = 1
# All values keep the ${VAR:-default} form so an environment override (e.g.
# REPLICAS=3 make docker-run SCENARIO=s1) wins over the scenario default.
CLUSTER_NAME="${CLUSTER_NAME:-bench-s1}"
WORKSPACE_NAME="${WORKSPACE_NAME:-s1-single-node}"
EXPECTED_NODE_COUNT="${EXPECTED_NODE_COUNT:-1}"

REPLICAS="${REPLICAS:-1}"                            # -> resources.replicas (pods)
GPU_COUNT_PER_REPLICA="${GPU_COUNT_PER_REPLICA:-1}" # -> resources.perReplica.gpuCount (GPUs/pod)
NODES_PER_REPLICA="${NODES_PER_REPLICA:-1}"         # -> modelServer.nodesPerReplica (pods/model)
