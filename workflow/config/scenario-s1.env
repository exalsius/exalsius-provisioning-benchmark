# Scenario 1 — Single-node inference. Deltas over common.env.
# One L40 node, one decode replica, one GPU per replica (tensor=1).
# Injected via the WorkspaceClass: replicas -> ms.decode.replicas,
# perReplica.gpuCount -> ms.decode.parallelism.tensor.
# All values keep the ${VAR:-default} form so an environment override (e.g.
# DECODE_REPLICAS=3 make docker-run SCENARIO=s1) wins over the scenario default.
CLUSTER_NAME="${CLUSTER_NAME:-bench-s1}"
WORKSPACE_NAME="${WORKSPACE_NAME:-s1-single-node}"
EXPECTED_NODE_COUNT="${EXPECTED_NODE_COUNT:-1}"

DECODE_REPLICAS="${DECODE_REPLICAS:-1}"              # -> ms.decode.replicas
GPU_COUNT_PER_REPLICA="${GPU_COUNT_PER_REPLICA:-1}" # -> ms.decode.parallelism.tensor
