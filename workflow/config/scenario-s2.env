# Scenario 2 — Replicated inference. Deltas over common.env.
# Two L40 nodes, two decode replicas (one full copy per node), tensor=1.
CLUSTER_NAME="bench-s2"
WORKSPACE_NAME="s2-replicated"
EXPECTED_NODE_COUNT=2

DECODE_REPLICAS=2        # -> ms.decode.replicas (one per node)
GPU_COUNT_PER_REPLICA=1  # -> ms.decode.parallelism.tensor
