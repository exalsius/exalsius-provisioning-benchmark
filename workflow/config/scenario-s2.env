# Scenario 2 — Replicated inference. Deltas over common.env.
# Two L40 nodes, two independent model-server pods (one whole model each).
#   TP = NODES_PER_REPLICA × GPU_COUNT_PER_REPLICA = 1 × 1 = 1
#   model copies = REPLICAS / NODES_PER_REPLICA = 2 / 1 = 2
# All values keep the ${VAR:-default} form so an environment override wins over
# the scenario default.
CLUSTER_NAME="${CLUSTER_NAME:-bench-s2}"
WORKSPACE_NAME="${WORKSPACE_NAME:-s2-replicated}"
EXPECTED_NODE_COUNT="${EXPECTED_NODE_COUNT:-2}"

REPLICAS="${REPLICAS:-2}"                           # -> resources.replicas (2 pods, 2 models)
GPU_COUNT_PER_REPLICA="${GPU_COUNT_PER_REPLICA:-1}" # -> resources.perReplica.gpuCount (GPUs/pod)
NODES_PER_REPLICA="${NODES_PER_REPLICA:-1}"         # -> modelServer.nodesPerReplica (pods/model)
# GPU_MEMORY_UTILIZATION: common.env default (0.85, shared across S1/S2/S3 for comparability)
