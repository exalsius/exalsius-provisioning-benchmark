# Scenario workload: an llm-d-model WorkspaceDeployment targeting the adopted
# benchmark cluster. Rendered per scenario by 30-deploy.sh.
#
# Topology (workspace-hub 1.0.0 / llm-d 0.9.0) — the chart owns a LeaderWorkerSet
# and reads _exalsius.resources directly (no resourceInjection):
#   resources.replicas            -> total model-server pods
#   resources.perReplica.gpuCount -> GPUs per pod  (--tensor-parallel-size = gpuCount × nodesPerReplica)
#   values.modelServer.nodesPerReplica -> pods per model copy (1 = whole model per pod)
# so model copies = replicas / nodesPerReplica. Per scenario:
#   S1 single-node   replicas=1 gpuCount=1 nodesPerReplica=1  -> 1 model,  TP=1
#   S2 replicated    replicas=2 gpuCount=1 nodesPerReplica=1  -> 2 models, TP=1
#   S3 sharded       replicas=2 gpuCount=1 nodesPerReplica=2  -> 1 model,  TP=2 (across 2 nodes)
apiVersion: workspaces.exalsius.ai/v1
kind: WorkspaceDeployment
metadata:
  name: ${WORKSPACE_NAME}
  namespace: ${WORKSPACE_NAMESPACE}
  labels:
    benchmark.exalsius.ai/scenario: ${WORKSPACE_NAME}
spec:
  workspaceClassRef: ${WORKSPACE_CLASS}
  clusterDeploymentRef:
    name: ${CLUSTER_NAME}
    namespace: ${KCM_NAMESPACE}
  resources:
    replicas: ${REPLICAS}
    perReplica:
      # cpu is set explicitly (below the class default of 8) so the model pod
      # fits alongside k0s/KCM/KOF/GPU-operator on the co-located benchmark node.
      # memory/storage fall back to the WorkspaceClass defaults (16Gi/50Gi).
      cpu: "${WORKSPACE_CPU}"
      gpuCount: ${GPU_COUNT_PER_REPLICA}
      # REQUIRED. The operator resolves the GPU extended-resource name from the
      # vendor (NVIDIA -> nvidia.com/gpu) and injects it as
      # _exalsius.resources.perReplica.gpuResourceName; the llm-d-model chart only
      # renders a GPU request when that is set. With NEITHER gpuVendor NOR a
      # gpuNodeSelector the operator injects gpuCount but no resource name, the
      # chart drops the GPU request, and vLLM starts CPU-only and crashes
      # ("Failed to infer device type"). gpuVendor is used (not a gpuNodeSelector)
      # so it does not depend on a GFD node label matching a specific GPU product.
      gpuVendor: ${GPU_VENDOR}
  values:
    # huggingfaceToken is a secret-typed field; the operator stores it in a
    # Secret. Rendered from $HF_TOKEN into the run manifest, then redacted from
    # the persisted copy by 30-deploy.sh right after apply.
    huggingfaceToken: "${HF_TOKEN}"
    model:
      # The vLLM model argument AND the name clients send / the gateway routes on.
      name: "${MODEL_ID}"
    modelServer:
      nodesPerReplica: ${NODES_PER_REPLICA}
      # modelServer.args REPLACES the chart's own args list wholesale (Helm does
      # not merge arrays), so both of the chart's default flags are re-stated
      # here — only the utilization value actually varies by scenario/env
      # (0.95 by default, matching the chart; lower for S3's cross-node TP,
      # which otherwise OOMs during CUDA-graph capture — see common.env).
      args:
        - "--disable-uvicorn-access-log"
        - "--gpu-memory-utilization=${GPU_MEMORY_UTILIZATION}"
    # Endpoint-picker routing profile. Default random-picker.yaml: picks
    # uniformly at random across replicas, ignoring all load-based scoring —
    # guarantees statistically even distribution over many requests. Least-busy
    # scheduling (payload-agnostic.yaml) can instead pathologically starve a
    # replica entirely: a backend fast enough to drain its queue back to ~0
    # between routing decisions keeps looking "least busy" and keeps winning,
    # so the other replica never receives a first request (see
    # docs/specs/scenario-2-replicated.md §7). The chart default
    # (default-plugins.yaml) weights prefix-cache affinity and concentrates
    # load even harder. Only affects multi-replica runs (S2).
    #
    # There is no genuine round-robin (strict sequential-cycling) picker in
    # this EPP version — random-picker is the closest built-in equivalent
    # (uniform distribution over many requests, not per-request cycling) and
    # is what "round-robin" means throughout this repo's docs/config.
    #
    # random-picker.yaml isn't shipped by the chart — pluginsCustomConfig is a
    # chart-provided extension hook (its content is rendered verbatim as
    # additional entries in the same ConfigMap the chart's own
    # default-plugins.yaml/payload-agnostic.yaml live in), then selected the
    # same way as those two, via pluginsConfigFile.
    igw:
      router:
        epp:
          pluginsConfigFile: ${EPP_PLUGINS_CONFIG}
          pluginsCustomConfig:
            random-picker.yaml: |
              apiVersion: llm-d.ai/v1alpha1
              kind: EndpointPickerConfig
              plugins:
              - type: passthrough-parser
              - type: random-picker
              requestHandler:
                parsers:
                - pluginRef: passthrough-parser
              schedulingProfiles:
              - name: default
                plugins:
                - pluginRef: random-picker
          # payload-agnostic.yaml's session-affinity-scorer and random-picker
          # itself are both experimental plugins; the flag only permits
          # experimental plugins, it does not enable any, so it's harmless for
          # default-plugins.yaml too.
          flags:
            allow-experimental-plugins: true
